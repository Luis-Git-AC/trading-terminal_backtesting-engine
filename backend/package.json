{
  "name": "@tt/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API, worker de backtests e ingestor de mercado",
  "main": "./dist/main.js",
  "scripts": {
    "dev:api": "echo \"[PENDIENTE F4-T1] esqueleto del API Express 5\"",
    "dev:worker": "echo \"[PENDIENTE F4-T6] worker de backtests\"",
    "dev:ingestor": "tsx --env-file-if-exists=../.env src/main.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env src/cli/migrate.ts",
    "db:seed": "echo \"[PENDIENTE F1-T3] fixtures sinteticos de desarrollo\"",
    "backfill": "tsx --env-file-if-exists=../.env src/cli/backfill.ts",
    "verify": "tsx --env-file-if-exists=../.env src/cli/verify.ts",
    "build": "echo \"[PENDIENTE F6-T5] build de produccion (requiere decidir el empaquetado de @tt/shared)\"",
    "typecheck": "tsc --noEmit",
    "test": "cd .. && vitest run --project backend --project backend:int",
    "test:unit": "cd .. && vitest run --project backend",
    "test:int": "cd .. && vitest run --project backend:int"
  },
  "dependencies": {
    "@tt/shared": "*",
    "bullmq": "^6.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6"
  }
}
