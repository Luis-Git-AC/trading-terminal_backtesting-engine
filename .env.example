# =============================================================================
# Trading Terminal — plantilla de entorno
#
#   cp .env.example .env
#
# Este fichero es la referencia de docs/06-DEPLOY.md §Variables de entorno y esta
# sincronizado con el esquema Zod de backend/src/config/env.ts. Hay un test que
# falla si divergen (backend/src/config/env.test.ts).
#
# NUNCA commitees .env. Las claves del exchange no se usan en el MVP: solo
# endpoints publicos, read-only. Ver CLAUDE.md §1.
# =============================================================================

# --- Proceso -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# api | worker | ingestor  — un unico artefacto, el rol lo decide esta variable
START_MODE=api
# Puerto HTTP (rol api; en Railway lo inyecta la plataforma)
PORT=4000
# pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Datos -------------------------------------------------------------------
# Si ya tienes un Postgres o un Redis nativos ocupando 5432/6379, define
# POSTGRES_PORT / REDIS_PORT en tu .env: docker-compose.yml los usa para mapear
# el puerto del host y solo hay que reflejarlo en las URLs de aqui abajo.
DATABASE_URL=postgres://tt:tt@localhost:5432/trading_terminal
# true en Railway / Postgres gestionado con TLS
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# --- API ---------------------------------------------------------------------
# Origen permitido por CORS (el frontend de Vite en local)
WEB_ORIGIN=http://localhost:5173

# --- Exchanges ----------------------------------------------------------------
# CSV de exchanges activos. Cada uno con sus URLs y sus simbolos.
# El primero es el que abre la UI y el defecto de los backtests
EXCHANGES=binance,hyperliquid
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com/stream
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HYPERLIQUID_REST_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_SYMBOLS=BTC,ETH,SOL

# --- Series a ingerir --------------------------------------------------------
# Los simbolos van arriba, por exchange (BINANCE_SYMBOLS, HYPERLIQUID_SYMBOLS)
# CSV. Valores admitidos: 1m, 15m, 1h
TIMEFRAMES=1m,15m,1h

# --- Backfill historico ------------------------------------------------------
# Hasta donde queremos histórico hacia atras (ISO 8601 UTC)
BACKFILL_FROM=2026-01-01T00:00:00Z
# Maximo de velas por pagina que pedimos; cada adapter recorta con su propio maximo
# (Binance 1500 en /fapi/v1/klines, Hyperliquid 5000 por snapshot)
BACKFILL_PAGE_LIMIT=200
# Rate limit propio de salida, requests/segundo
BACKFILL_RPS=5

# --- Ingesta en vivo (WebSocket) ---------------------------------------------
WS_RECONNECT_BASE_MS=1000
WS_RECONNECT_MAX_MS=30000
# Sin mensajes durante este tiempo -> se considera muerta y se reconecta
WS_STALE_TIMEOUT_MS=45000
# Ping de aplicacion al exchange; Hyperliquid espera {"method":"ping"} y responde {"channel":"pong"}
WS_HEARTBEAT_INTERVAL_MS=20000
# Tiempo abierto sin cortes tras el cual el contador de reconexiones vuelve a cero
WS_STABLE_RESET_MS=60000
# Tras estos fallos seguidos se logea a nivel error y se sigue al backoff maximo (nunca se abandona)
WS_MAX_CONSECUTIVE_FAILURES=10

# Paginas maximas que la reconciliacion pide al reabrir; si el hueco no cabe,
# se registra en ingest_gaps y lo rellena el job de huecos en vez de bloquear el arranque
RECONCILE_MAX_PAGES=10

# Auditoria periodica de huecos (formato cron de 5 campos)
GAP_SCAN_CRON=*/15 * * * *
# Ventana hacia atras que audita el scanner en cada pasada
GAP_SCAN_WINDOW_DAYS=7

# Recogida periodica de funding y open interest (formato cron de 5 campos).
# Vive en el ingestor hasta que F9-T1 cree el collector
DERIVATIVES_CRON=7 * * * *
# Cuanto se pide hacia atras la primera vez que se recoge un mercado.
# El tope es 30: openInterestHist de Binance no guarda mas
DERIVATIVES_LOOKBACK_DAYS=7

# --- Motor y worker de backtests ---------------------------------------------
BACKTEST_CONCURRENCY=2
BACKTEST_MAX_BARS=500000
ENGINE_CHUNK_BARS=50000
EQUITY_MAX_POINTS=5000
# Tope de backtests simultaneos en cola o ejecutandose. Al superarlo, el API
# responde 429 (RATE_LIMITED) en vez de aceptar trabajo que nadie va a mirar.
BACKTEST_MAX_ACTIVE_RUNS=25

# --- Rate limit del API ------------------------------------------------------
# Ventana y maximo de POST /api/backtests por IP dentro de esa ventana.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_BACKTESTS=60

# --- Solo desarrollo ---------------------------------------------------------
# Arranca el ingestor dentro del proceso worker para no pagar un tercer proceso.
# En produccion SIEMPRE false: el ingestor debe ser una unica instancia (ADR-001).
INGEST_IN_WORKER=false

# --- Frontend (Vite) ---------------------------------------------------------
# Se inyecta en el bundle: nunca pongas secretos en variables VITE_*
VITE_API_URL=http://localhost:4000
