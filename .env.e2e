# =============================================================================
# Trading Terminal — entorno del stack E2E (F6-T1)
#
# Este fichero SI se commitea: no tiene secretos y es parte de la definicion del
# entorno de test. El .env de desarrollo sigue sin commitearse.
#
# Los servicios corren dentro de docker-compose.e2e.yml, asi que las URLs apuntan
# a los nombres de servicio de la red de compose, no a localhost. Los puertos que
# se publican al host estan aislados de los de desarrollo (ver el compose).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=4000

DATABASE_URL=postgres://tt:tt@postgres:5432/trading_terminal_e2e
DATABASE_SSL=false
REDIS_URL=redis://redis:6379

WEB_ORIGIN=http://localhost:5173

# El E2E no habla con el exchange. El ingestor no existe en este stack: lo
# sustituye e2e/emitter.ts. Estas URLs apuntan al puerto discard para que
# cualquier intento de salida falle de forma ruidosa en vez de colarse.
EXCHANGE=bitget
EXCHANGE_REST_URL=http://127.0.0.1:9
EXCHANGE_WS_URL=ws://127.0.0.1:9

SYMBOLS=BTCUSDT
TIMEFRAMES=1m,15m

# El fixture arranca aqui; ver e2e/fixtures/README.md
BACKFILL_FROM=2026-07-01T00:00:00Z
BACKFILL_PAGE_LIMIT=200
BACKFILL_RPS=5

BACKTEST_CONCURRENCY=2
BACKTEST_MAX_BARS=500000
ENGINE_CHUNK_BARS=50000
EQUITY_MAX_POINTS=5000

INGEST_IN_WORKER=false

# --- Emisor local de velas (sustituye al ingestor) ---------------------------
E2E_EMIT_TIMEFRAME=1m
E2E_EMIT_INTERVAL_MS=1000
E2E_EMIT_FORMING_TICKS=2
E2E_EMIT_BARS=2000
E2E_EMIT_SEED=20260814
