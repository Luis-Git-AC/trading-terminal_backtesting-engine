{
  "//": "Vite empaqueta: resolucion de bundler, no NodeNext.",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "allowImportingTsExtensions": true,

    "paths": {
      "@/*": ["./src/*"],
      "@tt/shared": ["../shared/src/index.ts"],
      "@tt/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
