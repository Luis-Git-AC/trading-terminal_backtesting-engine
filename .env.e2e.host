# Overrides para los scripts del E2E que corren en el HOST, no dentro de compose.
# Se aplica encima de .env.e2e (node admite varios --env-file; gana el ultimo).
#
# Los puertos publicados por docker-compose.e2e.yml estan aislados de los de
# desarrollo a proposito: 55432 y 56379 en vez de 5432 y 6379, para poder tener
# los dos stacks levantados a la vez.

DATABASE_URL=postgres://tt:tt@localhost:55432/trading_terminal_e2e
REDIS_URL=redis://localhost:56379
