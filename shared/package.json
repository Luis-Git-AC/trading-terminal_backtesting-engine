{
  "name": "@tt/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tipos y esquemas Zod compartidos entre backend y frontend",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "cd .. && vitest run --project shared"
  },
  "dependencies": {
    "zod": "^4.1.12"
  }
}
